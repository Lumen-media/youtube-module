{
  "id": "com.lumen-media.youtube-module",
  "name": "YouTube",
  "version": "1.2.0",
  "api": "^0.1.0",
  "minLumenVersion": "0.1.0",
  "description": "Search YouTube videos and add them to your queue, library, or play them directly.",
  "author": {
    "name": "Lumen Media"
  },
  "entry": "main.js",
  "license": "MIT",
  "permissions": {
    "network": [
      "https://www.googleapis.com/youtube/v3/*",
      "https://www.youtube.com/*",
      "https://api.piped.private.coffee/*",
      "https://inv.zoomerville.com/*",
      "https://i.ytimg.com/*"
    ]
  }
}
